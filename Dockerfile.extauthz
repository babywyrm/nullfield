FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -ldflags="-s -w" -o /nullfield-extauthz ./cmd/nullfield-extauthz

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /nullfield-extauthz /nullfield-extauthz
USER nonroot:nonroot
EXPOSE 9191
ENTRYPOINT ["/nullfield-extauthz"]
